# Copy this file to .env and adjust for your machine.
# .env is git-ignored; never commit real credentials.

# SQLite (no setup needed)
DATABASE_URL=sqlite:///./stockpilot.db

# PostgreSQL, e.g. local or Neon (postgresql:// is converted to the psycopg 3 driver)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional direct (non-pooled) connection used by Alembic migrations:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Browser origins allowed to call the API (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
